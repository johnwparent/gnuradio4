<?xml version="1.0" encoding="utf-8"?>
<!--
  Unified GNU Radio 4 macOS installer.
  Generated by gr-super cmake/GenerateBundleDistribution.cmake from
  cmake/gr4_distribution.xml.in, do not edit.

  Composes each module's flat component packages into one distribution package.
  The bundle installs nothing of its own and registers nothing: every component
  package carries the pre/postinstall scripts that record it in the shared
  manifest, so a module installed from here and the same module installed on its
  own end up indistinguishable.

  There is no uninstaller here either; gr-core ships gr4-uninstall.
-->
<installer-gui-script minSpecVersion="2">
    <title>@GR4_BUNDLE_TITLE@</title>
    <organization>org.gnuradio</organization>

    <!-- customize="always" keeps the component selector one click away rather
         than behind a Customize button the user has to go looking for -->
    <options customize="always" require-scripts="false"
             hostArchitectures="@GR4_MACOS_HOST_ARCHITECTURES@"/>

    <!-- The payload installs to /usr/local/gnuradio4, so only the system domain
         makes sense. <domains> is the modern spelling; the older
         rootVolumeOnly attribute on <options> is ignored when it is present. -->
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>

    <volume-check>
        <allowed-os-versions>
            <os-version min="@GR4_MACOS_MIN_VERSION@"/>
        </allowed-os-versions>
    </volume-check>

@GR4_BUNDLE_LICENSE@
    <choices-outline>
@GR4_BUNDLE_CHOICES_OUTLINE@    </choices-outline>

@GR4_BUNDLE_CHOICES@
@GR4_BUNDLE_PKG_REFS@
</installer-gui-script>
