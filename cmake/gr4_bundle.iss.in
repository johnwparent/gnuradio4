; Unified GNU Radio 4 installer.
; Generated by gr-super cmake/GenerateBundleIss.cmake from cmake/gr4_bundle.iss.in.
;
; Embeds each module's own Inno Setup installer and runs the selected ones
; silently. The bundle installs nothing itself and has no uninstaller: every
; module keeps its own entry in Apps & Features.

#include "@GR4_INSTALLER_FILES_ISS@"
#include "@GR4_BUNDLE_TYPES_ISS@"

[Setup]
AppId=@BUNDLE_APP_ID@
AppName=GNU Radio 4
AppVersion=@BUNDLE_VERSION@
AppPublisher=GNU Radio
VersionInfoVersion=@BUNDLE_VERSION@
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; the shared manifest, not Inno's own registry entry, decides where GR 4 lives
DefaultDirName={code:GrGetInstallRoot}
UsePreviousAppDir=no
DisableProgramGroupPage=yes
; per-user like the module installers: elevating would move {localappdata}
; and {autopf} to the administrator's profile
PrivilegesRequired=lowest
Uninstallable=no
CreateUninstallRegKey=no
; the embedded installers are already compressed
Compression=none
WizardStyle=modern
OutputDir=@GR4_BUNDLE_OUTPUT_DIR@
OutputBaseFilename=@GR4_BUNDLE_OUTPUT_BASENAME@

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Components]
@GR4_BUNDLE_COMPONENTS@
[Files]
@GR4_BUNDLE_FILES@
[Code]
#include "@GR4_INSTALL_FLOW_ISS@"

type
  TGr4Entry = record
    Name: String;
    Id: String;
    Installer: String;
    Description: String;
    { the module's CPack components other than DEVELOP, comma-separated }
    Components: String;
    HasDevelop: Boolean;
  end;

var
  Gr4Entries: array of TGr4Entry;

procedure Gr4InitEntries();
begin
@GR4_BUNDLE_ENTRIES@end;

function Gr4ComponentsArgument(Index: Integer): String;
begin
  Result := Gr4Entries[Index].Components;
  if Gr4Entries[Index].HasDevelop and WizardIsComponentSelected(Gr4Entries[Index].Id + '\develop') then
  begin
    if Result <> '' then
      Result := Result + ',';
    Result := Result + 'DEVELOP';
  end;
end;

procedure Gr4RunInstallers();
var
  Index, Selected, Done, ResultCode: Integer;
  Parameters, LogPath, Components, Failures: String;
begin
  Gr4InitEntries();

  { Module installers refuse /DIR once a manifest exists, so they are not told
    where to install: recording the chosen root first makes each of them read
    it from the manifest instead. }
  if not GrRegisterInManifest() then
  begin
    SuppressibleMsgBox('The GNU Radio 4 install manifest could not be written:' + GrEol + GrManifestPath() +
      GrParagraph + 'No GNU Radio 4 components were installed.', mbError, MB_OK, IDOK);
    Exit;
  end;

  Selected := 0;
  for Index := 0 to GetArrayLength(Gr4Entries) - 1 do
    if WizardIsComponentSelected(Gr4Entries[Index].Id) then
      Selected := Selected + 1;
  WizardForm.ProgressGauge.Min := 0;
  WizardForm.ProgressGauge.Max := Selected;
  WizardForm.ProgressGauge.Position := 0;

  Done := 0;
  Failures := '';
  for Index := 0 to GetArrayLength(Gr4Entries) - 1 do
  begin
    if not WizardIsComponentSelected(Gr4Entries[Index].Id) then
      Continue;

    WizardForm.StatusLabel.Caption := Format('Installing %s...', [Gr4Entries[Index].Description]);
    WizardForm.FilenameLabel.Caption := Gr4Entries[Index].Installer;

    // not in the setup temp directory, which is removed when the bundle exits
    LogPath := ExpandConstant('{%TEMP}\gr4-bundle-') + Gr4Entries[Index].Name + '.log';
    { no /SUPPRESSMSGBOXES: it would silently answer "no" to a downgrade prompt }
    Parameters := '/VERYSILENT /NORESTART /LOG="' + LogPath + '"';
    Components := Gr4ComponentsArgument(Index);
    if Components <> '' then
      Parameters := Parameters + ' /COMPONENTS="' + Components + '"';

    { a line must never start with '[', the compiler would read it as a section tag }
    if not Exec(ExpandConstant('{tmp}\') + Gr4Entries[Index].Installer, Parameters, '', SW_SHOWNORMAL,
      ewWaitUntilTerminated, ResultCode) then
      Failures := Failures + GrEol + Format('%s could not be started: %s', [Gr4Entries[Index].Name,
        SysErrorMessage(ResultCode)])
    else if ResultCode <> 0 then
      Failures := Failures + GrEol + Format('%s failed with exit code %d, see %s', [Gr4Entries[Index].Name,
        ResultCode, LogPath]);

    Done := Done + 1;
    WizardForm.ProgressGauge.Position := Done;
  end;

  if Failures <> '' then
    SuppressibleMsgBox('Some GNU Radio 4 components were not installed:' + GrEol + Failures, mbError, MB_OK, IDOK);
end;

<event('CurStepChanged')>
procedure Gr4CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
    Gr4RunInstallers();
end;
