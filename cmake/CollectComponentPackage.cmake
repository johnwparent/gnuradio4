# Script mode: builds one module's flat macOS component packages, copies them
# into the bundle staging directory and records what the bundle needs to know
# about them.
#
#   cmake -DNAME=<module> -DBINARY_DIR=<module build dir> -DOUT_DIR=<dir>
#         [-DBUILD_PARALLEL_LEVEL=<n>] -P CollectComponentPackage.cmake
#
# This is the macOS counterpart of CollectComponentInstaller.cmake. Where that
# one builds a single self-contained installer per module, this builds one flat
# package per CPack component: macOS cannot nest a distribution package inside
# another, so the bundle has to reference real component packages.
#
# A module that does not configure a macOS installer ships no packages and is
# left out of the bundle rather than failing it.

foreach(variable NAME BINARY_DIR OUT_DIR)
  if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
    message(FATAL_ERROR "CollectComponentPackage.cmake requires -D${variable}=...")
  endif()
endforeach()

# Written at configure time by gr-core's GrProductBuild.cmake, so its presence is
# what tells us the module has a macOS installer at all -- the equivalent of
# CPackConfig.cmake existing on Windows.
set(productbuild_dir "${BINARY_DIR}/packaging/productbuild")
set(descriptor "${productbuild_dir}/pkgs/components.cmake")

# packages collected by an earlier build must not end up in the bundle
file(GLOB stale LIST_DIRECTORIES FALSE "${OUT_DIR}/${NAME}-*.pkg")
if(stale)
  file(REMOVE ${stale})
endif()
file(REMOVE "${OUT_DIR}/${NAME}.cmake")

if(NOT EXISTS "${productbuild_dir}/args.cmake")
  message(STATUS "${NAME} has no macOS installer configuration, it is not part of the bundle")
  return()
endif()

if(NOT "${BUILD_PARALLEL_LEVEL}" STREQUAL "")
  set(ENV{CMAKE_BUILD_PARALLEL_LEVEL} "${BUILD_PARALLEL_LEVEL}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --target gr4-component-pkgs
                COMMAND_ERROR_IS_FATAL ANY)

if(NOT EXISTS "${descriptor}")
  message(FATAL_ERROR "${NAME} built no component packages: ${descriptor} is missing")
endif()
include("${descriptor}")

file(MAKE_DIRECTORY "${OUT_DIR}")

# The packages are renamed to <module>-<component>.pkg on the way in. The module
# name is the one thing the superbuild controls, so prefixing with it keeps the
# staging directory unambiguous when two modules use the same CPack package name
# and makes the stale-file sweep above exact.
set(entries "")
foreach(entry IN LISTS GR4_COMPONENT_PKGS)
  string(REPLACE "|" ";" fields "${entry}")
  list(LENGTH fields field_count)
  if(NOT field_count EQUAL 4)
    message(FATAL_ERROR "Malformed component entry in ${descriptor}: ${entry}")
  endif()
  list(GET fields 0 component)
  list(GET fields 1 source_file)
  list(GET fields 2 identifier)
  list(GET fields 3 display)

  set(source "${productbuild_dir}/pkgs/${source_file}")
  if(NOT EXISTS "${source}")
    message(FATAL_ERROR "${descriptor} lists ${source_file}, which does not exist")
  endif()
  set(target_file "${NAME}-${component}.pkg")
  file(COPY_FILE "${source}" "${OUT_DIR}/${target_file}" ONLY_IF_DIFFERENT)

  list(APPEND entries "    [==[${component}|${target_file}|${identifier}|${display}]==]\n")
endforeach()

if(NOT entries)
  message(FATAL_ERROR "${descriptor} lists no component packages")
endif()
string(JOIN "" entries ${entries})

file(
  WRITE "${OUT_DIR}/${NAME}.cmake"
  "# Generated by gr-super cmake/CollectComponentPackage.cmake, do not edit.
set(GR4_COMPONENT_PACKAGE_NAME [==[${GR4_COMPONENT_PACKAGE_NAME}]==])
set(GR4_COMPONENT_VERSION [==[${GR4_COMPONENT_VERSION}]==])
set(GR4_COMPONENT_SUMMARY [==[${GR4_COMPONENT_SUMMARY}]==])
set(GR4_COMPONENT_CPACK_COMPONENTS [==[${GR4_COMPONENT_CPACK_COMPONENTS}]==])
# one \"COMPONENT|file|identifier|display name\" entry per flat component package
set(GR4_COMPONENT_PKGS
${entries})
")

message(STATUS "Collected ${NAME} component packages into ${OUT_DIR}")
