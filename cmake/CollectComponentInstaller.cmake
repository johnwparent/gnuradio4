# Script mode: builds one module's CPack installer, copies it into the bundle
# staging directory and records what the bundle needs to know about it.
#
#   cmake -DNAME=<module> -DBINARY_DIR=<module build dir> -DOUT_DIR=<dir>
#         [-DBUILD_PARALLEL_LEVEL=<n>] -P CollectComponentInstaller.cmake
#
# CPack's variables only exist in the module's own build tree, so they are read
# back from the CPackConfig.cmake it generated. A module without one ships no
# installer and is left out of the bundle rather than failing it.

foreach(variable NAME BINARY_DIR OUT_DIR)
  if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
    message(FATAL_ERROR "CollectComponentInstaller.cmake requires -D${variable}=...")
  endif()
endforeach()

set(cpack_config "${BINARY_DIR}/CPackConfig.cmake")
if(NOT EXISTS "${cpack_config}")
  # an installer collected by an earlier build must not end up in the bundle
  file(REMOVE "${OUT_DIR}/${NAME}.exe" "${OUT_DIR}/${NAME}.cmake")
  message(STATUS "${NAME} has no CPack configuration, it is not part of the bundle")
  return()
endif()

if(NOT "${BUILD_PARALLEL_LEVEL}" STREQUAL "")
  set(ENV{CMAKE_BUILD_PARALLEL_LEVEL} "${BUILD_PARALLEL_LEVEL}")
endif()
execute_process(
  COMMAND "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --target package
  COMMAND_ERROR_IS_FATAL ANY)

include("${cpack_config}")

set(installer "${BINARY_DIR}/${CPACK_PACKAGE_FILE_NAME}.exe")
if(CPACK_PACKAGE_FILE_NAME STREQUAL "" OR NOT EXISTS "${installer}")
  file(GLOB candidates LIST_DIRECTORIES FALSE "${BINARY_DIR}/*.exe")
  list(LENGTH candidates candidate_count)
  if(NOT candidate_count EQUAL 1)
    message(FATAL_ERROR
      "Cannot find the ${NAME} installer: expected ${installer}, "
      "found ${candidate_count} other installer(s) in ${BINARY_DIR}: ${candidates}")
  endif()
  list(GET candidates 0 installer)
endif()

file(MAKE_DIRECTORY "${OUT_DIR}")
file(COPY_FILE "${installer}" "${OUT_DIR}/${NAME}.exe" ONLY_IF_DIFFERENT)

set(summary "${CPACK_PACKAGE_DESCRIPTION_SUMMARY}")
if(summary STREQUAL "")
  set(summary "${CPACK_PACKAGE_NAME}")
endif()
file(CONFIGURE
  OUTPUT "${OUT_DIR}/${NAME}.cmake"
  CONTENT [=[
# Generated by gr-super cmake/CollectComponentInstaller.cmake, do not edit.
set(GR4_COMPONENT_PACKAGE_NAME [==[@CPACK_PACKAGE_NAME@]==])
set(GR4_COMPONENT_VERSION [==[@CPACK_PACKAGE_VERSION@]==])
set(GR4_COMPONENT_SUMMARY [==[@summary@]==])
set(GR4_COMPONENT_INSTALLER [==[@NAME@.exe]==])
set(GR4_COMPONENT_CPACK_COMPONENTS [==[@CPACK_COMPONENTS_ALL@]==])
]=]
  @ONLY)

message(STATUS "Collected ${installer} as ${OUT_DIR}/${NAME}.exe")
